# Blink intentionally does not expose DeepSeek keys to browser bundles.
# Phase 2 local proxy will read this from the developer machine:
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
BLINK_DEEPSEEK_PROXY_PORT=8787
BLINK_DEEPSEEK_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8164,http://127.0.0.1:8164
